---
import { getTeamManagerPages } from "../lib/teamManagerPages";
import { withBase } from "../lib/withBase";

interface Props {
  currentSlug?: string;
}

const { currentSlug } = Astro.props;
const pages = await getTeamManagerPages();
const currentPage = pages.find(({ slug }) => slug === currentSlug);
const topicsAnchor = "team-manager-topics";
---

<nav id={topicsAnchor} aria-label="Team manager topics" class="not-prose mb-10 scroll-mt-28 md:scroll-mt-32">
  <div>
    <h2 class="text-base font-black uppercase tracking-[0.12em] text-zinc-950">Need help with a team task?</h2>
    <p class="mt-2 text-sm leading-6 text-zinc-700">Choose a topic to view the relevant instructions.</p>
  </div>

  <details class="team-manager-topic-selector mt-6 md:hidden">
    <summary class={`cursor-pointer list-none border text-zinc-950 ${currentPage ? "team-manager-topic-card-selected p-5" : "flex min-h-14 items-center justify-between border-primary-container bg-primary-container px-4 py-3"}`}>
      <div class={`team-manager-topic-summary-closed ${currentPage ? "team-manager-selected-topic-card" : "flex min-w-0 w-full items-center justify-between gap-4"}`}>
        {currentPage ? (
          <>
            <div class="flex items-start justify-between gap-4">
              <div class="text-base font-black uppercase leading-tight tracking-[0.08em]">{currentPage.entry.data.title}</div>
              <span aria-hidden="true" class="material-symbols-outlined text-zinc-950">expand_more</span>
            </div>
            <div class="mt-3 text-sm leading-6 text-zinc-900">{currentPage.entry.data.summary}</div>
          </>
        ) : (
          <>
            <span class="min-w-0 truncate text-sm font-black uppercase tracking-[0.08em]">Select a topic</span>
            <span aria-hidden="true" class="material-symbols-outlined text-lg">expand_more</span>
          </>
        )}
      </div>
      <span class="team-manager-topic-summary-open">
        <span class="team-manager-topic-overlay-title text-sm font-black uppercase tracking-[0.12em]">Team Manager topics</span>
        <span aria-hidden="true" class="team-manager-topic-close-circle material-symbols-outlined text-2xl">close</span>
      </span>
    </summary>
    <div class="team-manager-topic-panel bg-tertiary-fixed">
      <div class="grid gap-4 p-4 pt-24">
      {pages.map(({ slug, href, entry }) => {
        const isCurrent = slug === currentSlug;

        return (
          <a
            aria-current={isCurrent ? "page" : undefined}
            class={`group border p-5 text-zinc-900 transition ${
              isCurrent
                ? "team-manager-topic-card-selected"
                : "border-zinc-200 bg-white hover:border-zinc-950 hover:bg-zinc-950 hover:text-white"
            }`}
            href={`${withBase(href)}#${topicsAnchor}`}
          >
            <div class="flex items-start justify-between gap-4">
              <h3 class="text-base font-black uppercase leading-tight tracking-[0.08em]">{entry.data.title}</h3>
              <span
              aria-hidden="true"
                class={`material-symbols-outlined transition group-hover:translate-x-1 ${isCurrent ? "text-primary-container" : "text-primary-container"}`}
              >
                arrow_forward
              </span>
            </div>
            <p class={`mt-3 text-sm leading-6 ${isCurrent ? "text-zinc-600" : "text-zinc-600 group-hover:text-zinc-200"}`}>{entry.data.summary}</p>
          </a>
        );
      })}
      </div>
    </div>
  </details>

  <div class="mt-6 hidden gap-4 md:grid md:grid-cols-2 xl:grid-cols-4">
    {pages.map(({ slug, href, entry }) => {
      const isCurrent = slug === currentSlug;

      return (
        <a
          aria-current={isCurrent ? "page" : undefined}
          class={`group border p-5 text-zinc-900 transition ${
            isCurrent
              ? "team-manager-topic-card-selected"
              : "border-zinc-200 bg-white hover:border-zinc-950 hover:bg-zinc-950 hover:text-white"
          }`}
          href={`${withBase(href)}#${topicsAnchor}`}
        >
          <div class="flex items-start justify-between gap-4">
            <h3 class="text-base font-black uppercase leading-tight tracking-[0.08em]">{entry.data.title}</h3>
            <span
              aria-hidden="true"
              class={`material-symbols-outlined transition group-hover:translate-x-1 ${isCurrent ? "text-primary-container" : "text-primary-container"}`}
            >
              arrow_forward
            </span>
          </div>
          <p class={`mt-3 text-sm leading-6 ${isCurrent ? "text-zinc-600" : "text-zinc-600 group-hover:text-zinc-200"}`}>{entry.data.summary}</p>
        </a>
      );
    })}
  </div>
</nav>

<style>
  .team-manager-topic-selector summary::-webkit-details-marker {
    display: none;
  }

  .team-manager-topic-summary-open {
    display: none;
    align-items: center;
    position: relative;
    width: 100%;
    min-height: 2.75rem;
    max-width: 100%;
    margin-inline: auto;
  }

  .team-manager-topic-overlay-title {
    position: absolute;
    left: 50%;
    top: 50%;
    width: calc(100% - 6rem);
    text-align: center;
    transform: translate(-50%, -50%);
  }

  .team-manager-selected-topic-card {
    display: block;
    width: 100%;
  }

  .team-manager-topic-card-selected {
    border-color: rgba(255, 199, 0, 0.95);
    background: #ffffff;
    box-shadow:
      0 0 0 2px rgba(255, 199, 0, 0.95),
      0 16px 40px rgba(245, 191, 0, 0.22);
  }

  .team-manager-topic-close-circle {
    position: absolute;
    right: 0;
    top: 50%;
    display: inline-flex;
    width: 2.75rem;
    height: 2.75rem;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    background: #ffc700;
    color: #171717;
    transform: translateY(-50%);
  }

  .team-manager-topic-selector summary .material-symbols-outlined {
    transition: transform 160ms ease;
  }

  @media (max-width: 767px) {
    .team-manager-topic-panel {
      position: fixed;
      inset: 0;
      z-index: 60;
      overflow-y: auto;
      overscroll-behavior: contain;
    }

    .team-manager-topic-selector[open] > summary {
      position: fixed;
      top: 0;
      right: 0;
      left: 0;
      z-index: 70;
      min-height: 4.75rem;
      border: 0;
      background: transparent;
      padding: 1rem;
      box-shadow: none;
    }

    .team-manager-topic-selector[open] .team-manager-topic-summary-open {
      display: flex;
      width: calc(100% - 2rem);
      max-width: 100%;
    }

    .team-manager-topic-selector[open] .team-manager-topic-summary-closed {
      display: none;
    }

  }
</style>

<style is:global>
  @media (max-width: 767px) {
    body:has(.team-manager-topic-selector[open]) {
      overflow: hidden;
      touch-action: none;
    }
  }
</style>
