---
import { getCollection, getEntry } from "astro:content";
import AgeGroups from "../components/AgeGroups.astro";
import HeroBanner from "../components/HeroBanner.astro";
import NewsTimeline from "../components/NewsTimeline.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const home = await getEntry("pages", "home");
const registration = await getEntry("registration", "main");

if (!home) {
  throw new Error("Missing home page content entry.");
}

if (!registration) {
  throw new Error("Missing registration data entry.");
}

const registrationSeasons = registration.data.seasons;
const ageGroupSeason = registrationSeasons.find((season) => season.status === "open")
  ?? registrationSeasons.find((season) => season.status === "closed")
  ?? registrationSeasons[0];

if (!ageGroupSeason) {
  throw new Error("Missing registration season data.");
}

const ageGroups = {
  title: "Age Groups",
  ctaLabel: "Play for Kangas",
  ctaHref: "/play/registration",
  seasonLabel: ageGroupSeason.title,
  groups: ageGroupSeason.ageGroups
};

const latestNews = (await getCollection("news"))
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime())
  .slice(0, home.data.newsSection.limit);
---

<BaseLayout title={home.data.metaTitle ?? home.data.title} description={home.data.metaDescription}>
  <HeroBanner {...home.data.hero} />
  <NewsTimeline entries={latestNews} {...home.data.newsSection} />
  <AgeGroups {...ageGroups} />
</BaseLayout>
