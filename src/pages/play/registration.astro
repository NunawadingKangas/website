---
import { getEntry, render } from "astro:content";
import { getSectionPage } from "../../lib/sectionPages";
import ButtonLink from "../../components/ButtonLink.astro";
import SectionPageTemplate from "../../components/SectionPageTemplate.astro";
import StatusBadge from "../../components/StatusBadge.astro";

const sectionPage = await getSectionPage("play", "registration");
const registration = await getEntry("registration", "main");

if (!sectionPage) {
  throw new Error("Missing registration content entry.");
}

if (!registration) {
  throw new Error("Missing registration data entry.");
}

const page = sectionPage.page;
const { Content } = await render(sectionPage.entry);
const { enquiriesCTA, missedRegistration } = registration.data;
type RegistrationSeason = (typeof registration.data.seasons)[number];
const closedSeason = registration.data.seasons.find((season) => season.status === "closed");
const registrationSeason = registration.data.seasons.find((season) => season.status === "soon-to-open")
  ?? registration.data.seasons.find((season) => season.status === "open");
const seasons = [closedSeason, registrationSeason]
  .filter((season): season is RegistrationSeason => Boolean(season))
  .sort((a, b) => a.order - b.order);
---

<SectionPageTemplate page={page}>
  <div slot="beforeBody" class="registration-season-cards" aria-label="Season registration options">
    {seasons.map((season, seasonIndex) => (
      <article class={`registration-season-card registration-season-card-${season.status}`}>
        <StatusBadge label={season.statusLabel} tone={season.status} />
        <h2>{season.title}</h2>
        {season.status !== "closed" && <p>{season.summary}</p>}
        {season.status !== "closed" && (
          <div class="registration-enquiries-row">
            <ButtonLink href={enquiriesCTA.href} label={enquiriesCTA.label} size="sm" variant="secondary" />
          </div>
        )}

        {season.status === "closed" ? (
          <>
            <button
              type="button"
              class="registration-season-details-toggle"
              aria-expanded="false"
              aria-controls={`registration-season-details-${seasonIndex}`}
              data-registration-panel-toggle
            >
              <span class="registration-toggle-text">View details</span>
              <span aria-hidden="true" class="material-symbols-outlined">expand_more</span>
            </button>
            <div
              id={`registration-season-details-${seasonIndex}`}
              class="registration-season-details-panel"
              data-registration-panel
              data-desktop-open
            >
              <div class="registration-season-details-content">
                <p>{season.summary}</p>
                <div class="registration-season-primary-actions">
                  <div class="registration-age-groups-compact registration-age-groups-mobile-list" aria-label={`${season.title} age groups`}>
                    {season.ageGroups.map((group) => (
                      <div class="registration-age-group-row">
                        <strong>{group.code}</strong>
                        <span>{group.name}</span>
                        <span>{group.dobFrom} - {group.dobTo}</span>
                      </div>
                    ))}
                  </div>
                  <div class="registration-age-groups-disclosure registration-age-groups-desktop-disclosure">
                    <button
                      type="button"
                      class="registration-age-groups-toggle"
                      aria-expanded="false"
                      aria-controls={`registration-age-groups-${seasonIndex}`}
                      data-registration-panel-toggle
                    >
                      <span class="registration-toggle-text">View age groups</span>
                      <span aria-hidden="true" class="material-symbols-outlined">expand_more</span>
                    </button>
                    <div
                      id={`registration-age-groups-${seasonIndex}`}
                      class="registration-age-groups-panel"
                      data-registration-panel
                    >
                      <div class="registration-age-groups-compact" aria-label={`${season.title} age groups`}>
                        {season.ageGroups.map((group) => (
                          <div class="registration-age-group-row">
                            <strong>{group.code}</strong>
                            <span>{group.name}</span>
                            <span>{group.dobFrom} - {group.dobTo}</span>
                          </div>
                        ))}
                      </div>
                    </div>
                  </div>
                  {season.closedCta && (
                    <ButtonLink href={season.closedCta.href} label={season.closedCta.label} size="sm" variant="secondary" />
                  )}
                </div>

                <div class="registration-missed-registration">
                  <div>
                    <h3>{missedRegistration.title}</h3>
                    <p>{missedRegistration.summary}</p>
                  </div>
                  <div class="registration-enquiries-row">
                    <ButtonLink href={enquiriesCTA.href} label={enquiriesCTA.label} size="sm" variant="secondary" />
                  </div>
                </div>
              </div>
            </div>
          </>
        ) : (
          <>
            <div class="registration-season-primary-actions">
              <div class="registration-age-groups-disclosure">
                <button
                  type="button"
                  class="registration-age-groups-toggle"
                  aria-expanded="false"
                  aria-controls={`registration-age-groups-${seasonIndex}`}
                  data-registration-panel-toggle
                >
                  <span class="registration-toggle-text">View age groups</span>
                  <span aria-hidden="true" class="material-symbols-outlined">expand_more</span>
                </button>
                <div
                  id={`registration-age-groups-${seasonIndex}`}
                  class="registration-age-groups-panel"
                  data-registration-panel
                >
                  <div class="registration-age-groups-compact" aria-label={`${season.title} age groups`}>
                    {season.ageGroups.map((group) => (
                      <div class="registration-age-group-row">
                        <strong>{group.code}</strong>
                        <span>{group.name}</span>
                        <span>{group.dobFrom} - {group.dobTo}</span>
                      </div>
                    ))}
                  </div>
                </div>
              </div>
            </div>

            <div class="registration-season-actions" aria-label={`${season.title} registration links`}>
              {season.links.map((link) => (
                <div>
                  <div>
                    <span>{link.gameDays}</span>
                    <strong>{link.ageGroups}</strong>
                  </div>
                  {season.status === "open" ? (
                    <ButtonLink href={link.href} label={link.label} size="sm" />
                  ) : (
                    <span class="registration-disabled-button" aria-disabled="true">
                      <span>{link.label}</span>
                    </span>
                  )}
                </div>
              ))}
            </div>
          </>
        )}
      </article>
    ))}
  </div>

  <div class="prose-content">
    <Content />
  </div>
</SectionPageTemplate>

<script>
  const desktopOpenQuery = window.matchMedia("(min-width: 768px)");

  const setPanelState = (toggle: HTMLButtonElement, panel: HTMLElement, isOpen: boolean) => {
    toggle.setAttribute("aria-expanded", String(isOpen));
    panel.setAttribute("aria-hidden", String(!isOpen));
    panel.classList.toggle("is-open", isOpen);
  };

  document.querySelectorAll<HTMLButtonElement>("[data-registration-panel-toggle]").forEach((toggle) => {
    const panelId = toggle.getAttribute("aria-controls");
    const panel = panelId ? document.getElementById(panelId) : null;

    if (!panel) {
      return;
    }

    const shouldDesktopOpen = panel.hasAttribute("data-desktop-open") && desktopOpenQuery.matches;
    setPanelState(toggle, panel, shouldDesktopOpen);

    toggle.addEventListener("click", () => {
      const isExpanded = toggle.getAttribute("aria-expanded") === "true";
      setPanelState(toggle, panel, !isExpanded);
    });
  });

  const syncDesktopPanels = () => {
    document.querySelectorAll<HTMLElement>("[data-registration-panel][data-desktop-open]").forEach((panel) => {
      const toggle = document.querySelector<HTMLButtonElement>(`[aria-controls="${panel.id}"]`);

      if (toggle) {
        setPanelState(toggle, panel, desktopOpenQuery.matches);
      }
    });
  };

  desktopOpenQuery.addEventListener("change", syncDesktopPanels);
</script>

<style>
  .registration-season-cards {
    display: grid;
    gap: 1rem;
  }

  .registration-season-card {
    display: flex;
    min-height: 0;
    flex-direction: column;
    gap: 1rem;
    border: 1px solid rgba(24, 24, 27, 0.12);
    background: #ffffff;
    padding: 1.5rem;
    box-shadow: 0 16px 42px rgba(23, 23, 23, 0.08);
  }

  .registration-season-card-closed {
    background: #f4f4f5;
  }

  .registration-season-card-soon-to-open {
    background: #fff7ed;
  }

  .registration-season-card-open {
    background: #fff8d6;
  }

  .registration-season-primary-actions {
    display: grid;
    align-items: start;
    gap: 0.75rem;
  }

  .registration-season-card :global(.parallelogram),
  .registration-disabled-button {
    justify-self: center;
  }

  .registration-season-primary-actions :global(.parallelogram),
  .registration-season-actions :global(.parallelogram) {
    min-height: 2.5rem;
    width: calc(100% - 1rem);
    align-items: center;
    justify-content: center;
    line-height: 1;
    margin-right: 0.5rem;
    margin-left: 0.5rem;
  }

  .registration-season-primary-actions :global(.skew-fix),
  .registration-season-actions :global(.skew-fix) {
    display: inline-flex;
    align-items: center;
    line-height: 1;
  }

  .registration-age-groups-disclosure {
    display: grid;
    gap: 0;
  }

  .registration-age-groups-desktop-disclosure {
    display: none;
  }

  .registration-age-groups-toggle,
  .registration-season-details-toggle {
    display: inline-flex;
    min-height: 2.5rem;
    width: fit-content;
    align-items: center;
    gap: 0.25rem;
    border: 0;
    background: transparent;
    color: #18181b;
    cursor: pointer;
    font-size: 0.85rem;
    font-weight: 900;
    line-height: 1.2;
    list-style: none;
    padding: 0;
    text-transform: uppercase;
  }

  .registration-toggle-text {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.25rem;
  }

  .registration-age-groups-toggle:focus-visible,
  .registration-season-details-toggle:focus-visible {
    outline: 2px solid #18181b;
    outline-offset: 0.35rem;
  }

  .registration-age-groups-toggle .material-symbols-outlined,
  .registration-season-details-toggle .material-symbols-outlined {
    font-size: 1.25rem;
    line-height: 1;
    text-decoration: none;
    transition: transform 220ms ease;
  }

  .registration-age-groups-toggle[aria-expanded="true"] .material-symbols-outlined,
  .registration-season-details-toggle[aria-expanded="true"] .material-symbols-outlined {
    transform: rotate(180deg);
  }

  .registration-age-groups-panel,
  .registration-season-details-panel {
    display: grid;
    grid-template-rows: 0fr;
    overflow: hidden;
    opacity: 0;
    transform: translateY(-0.2rem);
    transition:
      grid-template-rows 240ms ease,
      opacity 180ms ease,
      transform 240ms ease;
  }

  .registration-season-card-closed .registration-season-details-panel:not(.is-open) {
    margin-top: -1rem;
  }

  .registration-age-groups-panel.is-open,
  .registration-season-details-panel.is-open {
    grid-template-rows: 1fr;
    opacity: 1;
    transform: translateY(0);
  }

  .registration-season-details-content {
    display: grid;
    min-height: 0;
    gap: 1rem;
  }

  .registration-age-groups-compact {
    display: grid;
    min-height: 0;
    gap: 0.35rem;
    border-top: 1px solid rgba(24, 24, 27, 0.12);
    margin-top: 0.75rem;
    padding-top: 0.65rem;
  }

  .registration-season-details-content > .registration-season-primary-actions > .registration-age-groups-compact {
    margin-top: 0;
  }

  .registration-age-group-row {
    display: grid;
    grid-template-columns: 3.25rem minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 0.5rem;
    color: #3f3f46;
    font-size: 0.85rem;
    line-height: 1.35;
    padding: 0.35rem 0.5rem;
  }

  .registration-age-group-row:nth-child(odd) {
    background: rgba(24, 24, 27, 0.045);
  }

  .registration-age-group-row strong {
    color: #18181b;
    font-weight: 900;
  }

  .registration-age-group-row span:last-child {
    color: #71717a;
    white-space: nowrap;
  }

  @media (prefers-reduced-motion: reduce) {
    .registration-age-groups-panel,
    .registration-season-details-panel,
    .registration-age-groups-toggle .material-symbols-outlined,
    .registration-season-details-toggle .material-symbols-outlined {
      transition: none;
    }
  }

  .registration-season-card h2 {
    margin: 0;
    color: #18181b;
    font-size: 1.75rem;
    font-weight: 900;
    letter-spacing: 0;
    line-height: 1.12;
    text-transform: uppercase;
  }

  .registration-season-card p {
    margin: 0;
    color: #3f3f46;
    font-size: 1rem;
    line-height: 1.5;
  }

  .registration-missed-registration,
  .registration-season-actions {
    display: grid;
    gap: 0.75rem;
  }

  .registration-missed-registration,
  .registration-season-actions > div {
    display: grid;
    gap: 0.75rem;
    border-top: 1px solid rgba(24, 24, 27, 0.12);
    padding-top: 0.75rem;
  }

  .registration-enquiries-row {
    display: flex;
    justify-content: flex-start;
    padding-inline: 0.2rem;
  }

  .registration-season-actions > .registration-enquiries-row {
    border-top: 0;
    padding-top: 0;
  }

  .registration-enquiries-row :global(.parallelogram) {
    min-height: 0;
    height: 2rem;
    width: fit-content;
    margin: 0;
    align-items: center;
    justify-content: center;
    padding: 0 0.8rem;
    line-height: 1;
  }

  .registration-enquiries-row :global(.skew-fix) {
    display: inline-flex;
    align-items: center;
    font-size: 0.75rem;
    line-height: 1;
  }

  .registration-season-actions > div > div span {
    display: block;
    color: #52525b;
    font-size: 0.95rem;
    font-weight: 800;
    line-height: 1.35;
  }

  .registration-season-actions strong {
    display: block;
    color: #18181b;
    font-size: 0.95rem;
    line-height: 1.35;
  }

  .registration-missed-registration {
    align-items: start;
  }

  .registration-missed-registration .registration-enquiries-row {
    justify-content: flex-start;
  }

  .registration-missed-registration > div {
    display: grid;
    gap: 0.5rem;
  }

  .registration-missed-registration h3 {
    margin: 0;
    color: #18181b;
    font-size: 0.95rem;
    font-weight: 900;
    line-height: 1.25;
    text-transform: uppercase;
  }

  .registration-missed-registration p {
    color: #52525b;
    font-size: 0.9rem;
    line-height: 1.45;
  }

  .registration-disabled-button {
    position: relative;
    display: inline-flex;
    width: calc(100% - 1rem);
    min-height: 2.5rem;
    align-items: center;
    justify-content: center;
    max-width: 100%;
    overflow: hidden;
    transform: skewX(-12deg);
    transform-origin: center;
    border: 0;
    background: #d4d4d8;
    color: #52525b;
    cursor: not-allowed;
    opacity: 0.88;
    pointer-events: none;
    margin-right: 0.5rem;
    margin-left: 0.5rem;
    padding: 0.5rem 1rem;
    font-size: 0.875rem;
    font-style: italic;
    font-weight: 900;
    letter-spacing: 0.04em;
    line-height: 1;
    text-align: center;
    text-decoration: none;
    text-transform: uppercase;
    user-select: none;
    white-space: nowrap;
  }

  .registration-disabled-button > span {
    display: inline-flex;
    align-items: center;
    min-height: 1em;
    transform: skewX(12deg);
    color: inherit;
    line-height: 1;
  }

  .registration-disabled-button::after {
    content: "";
    position: absolute;
    inset: 0;
    border: 1px solid rgba(82, 82, 91, 0.18);
    pointer-events: none;
  }

  @media (max-width: 767px) {
    .registration-season-card h2 {
      font-size: 1.35rem;
    }

    .registration-age-group-row {
      grid-template-columns: 2.25rem minmax(0, 1fr) auto;
    }
  }

  @media (min-width: 768px) {
    .registration-season-cards {
      align-items: stretch;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .registration-season-card {
      height: 100%;
    }

    .registration-season-card :global(.parallelogram),
    .registration-disabled-button {
      justify-self: start;
    }

    .registration-season-primary-actions :global(.parallelogram),
    .registration-season-actions :global(.parallelogram),
    .registration-disabled-button {
      width: fit-content;
      margin-right: 0;
      margin-left: 0;
    }

    .registration-season-actions > div {
      justify-items: stretch;
      text-align: left;
    }

    .registration-season-actions :global(.parallelogram),
    .registration-season-actions .registration-disabled-button {
      width: calc(100% - 1rem);
      justify-self: center;
      margin-right: 0.5rem;
      margin-left: 0.5rem;
    }

    .registration-enquiries-row :global(.parallelogram) {
      width: fit-content;
      margin: 0;
    }

    .registration-season-card-closed .registration-season-details-panel {
      margin-top: 0;
    }

    .registration-missed-registration,
    .registration-season-actions {
      margin-top: auto;
    }

    .registration-season-details-toggle {
      display: none;
    }

    .registration-season-details-panel {
      grid-template-rows: 1fr;
      overflow: visible;
      opacity: 1;
      transform: none;
    }

    .registration-age-groups-mobile-list {
      display: none;
    }

    .registration-age-groups-desktop-disclosure {
      display: grid;
    }

  }

  @media (min-width: 1180px) {
    .registration-season-actions > div {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      justify-items: stretch;
      text-align: left;
    }

    .registration-season-actions :global(.parallelogram),
    .registration-season-actions .registration-disabled-button {
      width: fit-content;
      justify-self: end;
      margin-right: 0;
      margin-left: 0;
    }
  }
</style>
