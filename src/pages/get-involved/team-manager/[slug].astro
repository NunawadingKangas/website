---
import { render } from "astro:content";
import AngularDivider from "../../../components/design-system/AngularDivider.astro";
import PageHeader from "../../../components/PageHeader.astro";
import TeamManagerNav from "../../../components/TeamManagerNav.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getTeamManagerPages } from "../../../lib/teamManagerPages";
import type { TeamManagerPageEntry } from "../../../lib/teamManagerPages";

export async function getStaticPaths() {
  const pages = await getTeamManagerPages();

  return pages.map(({ slug, entry }) => ({
    params: { slug },
    props: { entry, slug }
  }));
}

interface Props {
  entry: TeamManagerPageEntry;
  slug: string;
}

const { entry, slug } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout title={entry.data.metaTitle ?? `${entry.data.title} | Team Manager | Nunawading Kangas`} description={entry.data.metaDescription}>
  <div class="hero-gradient-surface">
    <PageHeader eyebrow="Team Manager" title={entry.data.title} summary={entry.data.summary} />
    <section class="relative bg-tertiary-fixed pb-24 pt-4 text-surface md:pb-28 md:pt-6">
      <div class="section-wrap">
        <article class="bg-white p-6 shadow-sm md:p-10">
          <TeamManagerNav currentSlug={slug} />
          <div class="prose-content">
            <Content />
          </div>
        </article>
      </div>
      <AngularDivider fill="yellow" direction="reverse" from="light" />
    </section>
  </div>
</BaseLayout>
