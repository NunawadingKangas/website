---
import SectionMarkdownPage from "../../components/SectionMarkdownPage.astro";
import TeamManagerLanding from "../../components/TeamManagerLanding.astro";
import { getSectionPagesForSection } from "../../lib/sectionPages";
import type { SectionPageEntry } from "../../lib/sectionPages";

export async function getStaticPaths() {
  const pages = await getSectionPagesForSection("get-involved");

  return pages.map(({ slug, entry }) => ({
    params: { slug },
    props: { entry }
  }));
}

interface Props {
  entry: SectionPageEntry;
}

const { entry } = Astro.props;
const isTeamManagerLanding = entry.id === "get-involved/team-manager.md";
---

{isTeamManagerLanding ? <TeamManagerLanding entry={entry} /> : <SectionMarkdownPage entry={entry} />}
